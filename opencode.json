{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--viewport-size=1280x720",
        "--caps=testing",
        "--output-dir=./evidencias"
      ],
      "enabled": true
    }
  },
  "tools": {
    "playwright_browser_run_code_unsafe": false
  }
}
